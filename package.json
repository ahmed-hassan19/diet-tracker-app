{
  "name": "diet-tracker-app",
  "version": "3.15.1",
  "private": true,
  "description": "Arabic RTL diet tracker hosted on Firebase",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "icons:check": "node scripts/generate-icons.mjs --check",
    "format": "prettier --write \"*.md\" \"docs/*.md\" \"*.json\"",
    "format:check": "prettier --check \"*.md\" \"docs/*.md\" \"*.json\"",
    "lint": "node scripts/validate.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/rules/*.test.mjs\"",
    "test:browser": "playwright test",
    "check:static": "npm run format:check && npm run lint && npm run test:unit",
    "check": "npm run check:static && npm run test:rules",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "firebase": "13.1.0",
    "firebase-tools": "15.34.1",
    "prettier": "3.9.10"
  },
  "overrides": {
    "@google-cloud/pubsub": "6.0.1",
    "gaxios@6": {
      "uuid": "11.1.1"
    },
    "@grpc/grpc-js": "1.14.6",
    "basic-ftp": "6.2.3",
    "fast-uri": "3.1.8"
  }
}
