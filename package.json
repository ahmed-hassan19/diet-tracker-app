{
  "name": "diet-tracker-app",
  "version": "3.2.0",
  "private": true,
  "description": "Arabic RTL diet tracker hosted on Firebase",
  "scripts": {
    "format": "prettier --write \"*.md\" \"*.json\"",
    "format:check": "prettier --check \"*.md\" \"*.json\"",
    "lint": "node scripts/validate.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/rules/*.test.mjs\"",
    "test:browser": "playwright test",
    "check:static": "npm run format:check && npm run lint && npm run test:unit",
    "check": "npm run check:static && npm run test:rules",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@playwright/test": "1.62.0",
    "firebase": "12.16.0",
    "firebase-tools": "15.24.0",
    "prettier": "3.9.6"
  }
}
