rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Data model:
    // /trackers/{uid}: exactly days (map), settings (map), foods (map),
    // calref (map), and updated (integer milliseconds). The document is private
    // to uid. Enabled /betaMembers/{uid} membership is required only for create
    // and update; owner get/read/export/delete remains available after revocation.
    // /betaMembers/{uid}: owner-provisioned membership; app clients may only get
    // their own document and can never list or write membership documents.
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    function betaEnabled() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/betaMembers/$(request.auth.uid))
        && get(/databases/$(database)/documents/betaMembers/$(request.auth.uid)).data.enabled == true;
    }
    function validMillis(value) {
      return value is int
        && value >= 1577836800000
        && value <= request.time.toMillis() + 300000;
    }
    function optionalNumber(data, key, minimum, maximum) {
      return !(key in data) || (data[key] is number && data[key] >= minimum && data[key] <= maximum);
    }
    function optionalInt(data, key, minimum, maximum) {
      return !(key in data) || (data[key] is int && data[key] >= minimum && data[key] <= maximum);
    }
    function optionalList(data, key, maximum) {
      return !(key in data) || (data[key] is list && data[key].size() <= maximum);
    }
    function optionalMillis(data, key) {
      return !(key in data) || validMillis(data[key]);
    }
    function validDayKeys(data) {
      let keys = data.keys();
      let joined = keys.join(',');
      return keys.size() == 0 || (
        joined.size() == keys.size() * 11 - 1
        && joined.matches('^([0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]))(,([0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])))*$')
      );
    }
    function validCanonicalPastTime(value) {
      return value is string
        && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z$')
        && timestamp.date(int(value[0:4]), int(value[5:7]), int(value[8:10]))
          + duration.time(int(value[11:13]), int(value[14:16]), int(value[17:19]), int(value[20:23]) * 1000000)
          <= request.time;
    }
    function validSettings(data) {
      return data is map
        && data.keys().hasOnly([
          'name', 'sex', 'age', 'ht', 'act', 'klo', 'khi', 'plo', 'phi',
          'sw', 'gw', 'tw', '_ts', 'targetFormulaVersion',
          'healthNoticeVersion', 'healthNoticeAcceptedAt',
          'aiDisclosureVersion', 'aiDisclosureAcceptedAt'
        ])
        && (!('name' in data) || (data.name is string && data.name.size() <= 40))
        && (!('sex' in data) || data.sex in ['m', 'f'])
        && optionalInt(data, 'age', 18, 100)
        && optionalInt(data, 'ht', 120, 230)
        && (!('act' in data) || (data.act is number && data.act in [1.2, 1.375, 1.55, 1.725]))
        && optionalNumber(data, 'klo', 1200, 6000)
        && optionalNumber(data, 'khi', 1200, 6000)
        && optionalNumber(data, 'plo', 40, 300)
        && optionalNumber(data, 'phi', 40, 300)
        && optionalNumber(data, 'sw', 30, 300)
        && optionalNumber(data, 'gw', 30, 300)
        && optionalNumber(data, 'tw', 0, 300)
        && (!('tw' in data) || data.tw == 0 || data.tw >= 30)
        && (!('klo' in data) || !('khi' in data) || data.klo <= data.khi)
        && (!('plo' in data) || !('phi' in data) || data.plo <= data.phi)
        && optionalMillis(data, '_ts')
        && (!('targetFormulaVersion' in data) || (data.targetFormulaVersion is int && data.targetFormulaVersion == 1))
        && (('healthNoticeVersion' in data) == ('healthNoticeAcceptedAt' in data))
        && (!('healthNoticeVersion' in data) || (
          data.healthNoticeVersion is int
          && data.healthNoticeVersion == 1
          && validCanonicalPastTime(data.healthNoticeAcceptedAt)
        ))
        && (('aiDisclosureVersion' in data) == ('aiDisclosureAcceptedAt' in data))
        && (!('aiDisclosureVersion' in data) || (
          data.aiDisclosureVersion is int
          && data.aiDisclosureVersion == 1
          && data.aiDisclosureAcceptedAt is string
          && data.aiDisclosureAcceptedAt.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z$')
        ));
    }
    function validFoods(data) {
      return data is map
        && data.keys().hasOnly(['b', 'bc', 's', 'l', 'cf', 'pw', 'nt', 'd', 'extras', '_ts'])
        && optionalList(data, 'b', 200)
        && optionalList(data, 'bc', 200)
        && optionalList(data, 's', 200)
        && optionalList(data, 'l', 200)
        && optionalList(data, 'cf', 200)
        && optionalList(data, 'pw', 200)
        && optionalList(data, 'nt', 200)
        && optionalList(data, 'd', 200)
        && optionalList(data, 'extras', 200)
        && data.get('b', []).size() + data.get('bc', []).size()
          + data.get('s', []).size() + data.get('l', []).size()
          + data.get('cf', []).size() + data.get('pw', []).size()
          + data.get('nt', []).size() + data.get('d', []).size()
          + data.get('extras', []).size() <= 200
        && optionalMillis(data, '_ts');
    }
    function validCalref(data) {
      return data is map
        && data.keys().hasOnly(['items', '_ts'])
        && optionalList(data, 'items', 500)
        && optionalMillis(data, '_ts');
    }
    function validTracker(data) {
      return data is map
        && data.keys().hasAll(['days', 'settings', 'foods', 'calref', 'updated'])
        && data.keys().hasOnly(['days', 'settings', 'foods', 'calref', 'updated'])
        && data.days is map
        && data.days.size() <= 1095
        && validDayKeys(data.days)
        && validSettings(data.settings)
        && validFoods(data.foods)
        && validCalref(data.calref)
        && validMillis(data.updated);
    }

    match /trackers/{uid} {
      allow get, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && betaEnabled() && validTracker(request.resource.data);
    }
    match /trackers/{uid}/{document=**} {
      allow read, write: if false;
    }
    match /betaMembers/{uid} {
      allow get: if isOwner(uid);
      // list, create, update, and delete are denied for all app clients.
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
